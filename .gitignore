# ASP.NET Core API build output
/api/**/bin/
/api/**/obj/

# Firebase service account keys belong in the FIREBASE_SERVICE_ACCOUNT_JSON setting, never in the repo
*firebase-adminsdk*.json
*service-account*.json

# Release signing: the keystore and its passwords live outside the repo (see the README)
*.jks
*.keystore
keystore.properties
signing.properties

# Built packages and archives belong in GitHub Releases, never in the repo
*.apk
*.aab
*.zip

# Android Studio project settings are per machine
.idea/
